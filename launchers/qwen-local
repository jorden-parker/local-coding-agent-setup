#!/usr/bin/env bash
# Runs Qwen Code against the local llama-server (OpenAI-compatible /v1 API).
# Installed by setup.sh. Reads ALIAS and PORT from
# ${XDG_CONFIG_HOME:-~/.config}/llama-coder/config.env; PORT= in the
# environment overrides the file. Must match the PORT llama-coder used.
# OPENAI_API_KEY must be set (any value) or Qwen Code will not select the
# OpenAI-compatible auth type (Qwen Code docs: users/configuration/auth.md).
set -eo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/llama-coder/config.env"
[[ -f "$CONFIG" ]] || { echo "Missing $CONFIG. Run setup.sh first." >&2; exit 1; }

env_port="${PORT:-}"
# shellcheck source=/dev/null
source "$CONFIG"
[[ -n "$env_port" ]] && PORT="$env_port"
[[ -n "${ALIAS:-}" && -n "${PORT:-}" ]] || { echo "ALIAS and PORT must be set in $CONFIG" >&2; exit 1; }

if ! curl -sf "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
  echo "llama-server is not running on port ${PORT}. Start it with: llama-coder" >&2
  exit 1
fi
export OPENAI_BASE_URL="http://127.0.0.1:${PORT}/v1"
export OPENAI_API_KEY="local"
export OPENAI_MODEL="$ALIAS"
exec qwen "$@"
